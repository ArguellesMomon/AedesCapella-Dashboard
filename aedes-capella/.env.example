VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# The detailed vector map defaults to OpenFreeMap (https://openfreemap.org), a
# keyless style with no published request quota. Leave the vars below unset to
# use it.
#
# To point the detailed map at a different MapLibre style (self-hosted, or a
# paid MapTiler style.json URL), set VITE_MAP_STYLE_URL and it wins outright.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/YOUR_MAP_ID/style.json?key=YOUR_KEY
#
# To use MapTiler specifically (so its key is attached to tile/font/sprite
# requests via transformRequest), set VITE_MAP_PROVIDER=maptiler in addition to
# both credentials below. Having the credentials alone is not enough on
# purpose: a stale or rate-limited MapTiler key must never silently become the
# production basemap again. Restrict the key to the production and preview
# domains in the MapTiler dashboard.
# VITE_MAP_PROVIDER=maptiler
VITE_MAPTILER_MAP_ID=YOUR_MAP_ID
VITE_MAPTILER_KEY=YOUR_PUBLIC_ORIGIN_RESTRICTED_KEY

# Optional Leaflet fallback override. OpenStreetMap remains the default fallback.
VITE_MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=Map data attribution required by the selected provider

# Dashboard display cutoff, used only until migration 202609280001 is applied.
# After that, public.dashboard_settings.display_from in the database wins.
VITE_DISPLAY_FROM=2026-09-29T00:00:00+08:00
